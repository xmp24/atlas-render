"booms": [], "marks": [], "rules": [[4.7, 24.09, 1588, "SPAIN WANTS REVENGE", "THE SPANISH ARMADA", "\u2694\ufe0f"], [24.19, 40.96, 1709, "SWEDEN WANTS REVENGE", "BATTLE OF POLTAVA", "\u2694\ufe0f"], [41.06, 62.73, 1842, "CHINA WANTS REVENGE", "FIRST OPIUM WAR", "\u2694\ufe0f"], [62.83, 79.87, 1848, "MEXICO WANTS REVENGE", "MEXICAN-AMERICAN WAR", "\u2694\ufe0f"], [79.97, 94.13, 1864, "DENMARK WANTS REVENGE", "SECOND SCHLESWIG WAR", "\u2694\ufe0f"], [94.23, 109.11, 1866, "AUSTRIA WANTS REVENGE", "AUSTRO-PRUSSIAN WAR", "\u2694\ufe0f"], [109.21, 126.02, 1870, "PARAGUAY WANTS REVENGE", "PARAGUAYAN WAR", "\u2694\ufe0f"], [126.12, 141.81, 1871, "FRANCE WANTS REVENGE", "FRANCO-PRUSSIAN WAR", "\u2694\ufe0f"], [141.91, 162.31, 1880, "AFGHANISTAN WANTS REVENGE", "SECOND ANGLO-AFGHAN WAR", "\u2694\ufe0f"], [162.41, 181.69, 1882, "EGYPT WANTS REVENGE", "ANGLO-EGYPTIAN WAR", "\u2694\ufe0f"], [181.79, 196.45, 1883, "PERU WANTS REVENGE", "WAR OF THE PACIFIC", "\u2694\ufe0f"], [196.55, 219.83, 1884, "BOLIVIA WANTS REVENGE", "WAR OF THE PACIFIC", "\u2694\ufe0f"], [219.93, 234.56, 1895, "CHINA WANTS REVENGE", "FIRST SINO-JAPANESE WAR", "\u2694\ufe0f"], [234.66, 250.42, 1896, "ITALY WANTS REVENGE", "BATTLE OF ADWA", "\u2694\ufe0f"], [250.52, 273.53, 1905, "RUSSIA WANTS REVENGE", "RUSSO-JAPANESE WAR", "\u2694\ufe0f"], [273.63, 290.23, 1913, "BULGARIA WANTS REVENGE", "SECOND BALKAN WAR", "\u2694\ufe0f"], [290.33, 309.25, 1918, "TURKEY WANTS REVENGE", "WORLD WAR ONE", "\u2694\ufe0f"], [309.35, 323.81, 1919, "HUNGARY WANTS REVENGE", "HUNGARIAN-ROMANIAN WAR", "\u2694\ufe0f"], [323.91, 344.5, 1922, "GREECE WANTS REVENGE", "GRECO-TURKISH WAR", "\u2694\ufe0f"], [344.6, 359.08, 1933, "PERU WANTS REVENGE", "COLOMBIA-PERU WAR", "\u2694\ufe0f"], [359.18, 380.8, 1940, "FINLAND WANTS REVENGE", "WINTER WAR", "\u2694\ufe0f"], [380.9, 401.65, 1941, "ECUADOR WANTS REVENGE", "ECUADORIAN-PERUVIAN WAR", "\u2694\ufe0f"], [401.75, 416.49, 1949, "NETHERLANDS WANTS REVENGE", "INDONESIAN INDEPENDENCE", "\u2694\ufe0f"], [416.59, 432.19, 1961, "PORTUGAL WANTS REVENGE", "ANNEXATION OF GOA", "\u2694\ufe0f"], [432.29, 447.78, 1962, "INDIA WANTS REVENGE", "SINO-INDIAN WAR", "\u2694\ufe0f"], [447.88, 467.88, 1971, "PAKISTAN WANTS REVENGE", "INDO-PAKISTANI WAR", "\u2694\ufe0f"], [467.98, 482.98, 1975, "UNITED STATES WANTS REVENGE", "VIETNAM WAR", "\u2694\ufe0f"], [483.08, 502.47, 1978, "SOMALIA WANTS REVENGE", "OGADEN WAR", "\u2694\ufe0f"], [502.57, 517.39, 1979, "UGANDA WANTS REVENGE", "UGANDA-TANZANIA WAR", "\u2694\ufe0f"], [517.49, 540.14, 1982, "ARGENTINA WANTS REVENGE", "FALKLANDS WAR", "\u2694\ufe0f"], [540.25, 556.03, 1987, "LIBYA WANTS REVENGE", "TOYOTA WAR", "\u2694\ufe0f"], [556.13, 576.67, 2008, "GEORGIA WANTS REVENGE", "RUSSO-GEORGIAN WAR", "\u2694\ufe0f"]], "chips": [], "subs": [[0.15, 4.75, "Every country that lost a war gets one shot at revenge. Let's go!"], [4.85, 16.14, "1588. Spain sends the biggest fleet in the world to invade England... And a storm wrecks it. Spain has been waiting four hundred years for this!"], [20.84, 24.19, "Revenge! Spain takes the UK!"], [24.34, 33.72, "1709. Sweden was a superpower, until Russia crushed it at Poltava. Sweden is back, and it's angry!"], [38.42, 41.06, "Ouch! Russia wins again!"], [41.21, 49.16, "1842. Britain beats China in the Opium War and takes Hong Kong. China wants it all back!"], [49.21, 54.73, "But the UK is gone. Spain owns that land now, so China attacks them!"], [59.43, 62.83, "Payback time! Spain falls to China!"], [62.98, 71.43, "1848. Mexico loses half its land, Texas, California, all of it. Mexico wants it back!"], [76.13, 79.97, "History repeats itself. The United States wins."], [80.12, 86.48, "1864. Prussia steals Schleswig from Denmark. The Danes never forgot!"], [91.18, 94.23, "Not again! Germany takes Denmark!"], [94.38, 101.11, "1866. Austria gets destroyed by Prussia in just seven weeks. Rematch!"], [105.81, 109.21, "Some things never change. Germany wins!"], [109.36, 117.83, "1870. Paraguay fights three countries at once and loses most of its men. Now Paraguay goes after Brazil!"], [122.53, 126.12, "Revenge failed! Brazil is too strong!"], [126.27, 133.6, "1871. Germany surrounds Paris and France surrenders. Round two, let's go!"], [138.3, 141.91, "Oh no! France loses... Again!"], [142.06, 149.35, "1880. Britain takes control of Afghanistan. Now the graveyard of empires wants payback!"], [149.4, 155.09, "But the UK is gone. China owns that land now, so Afghanistan attacks them!"], [159.79, 162.41, "Ouch! China wins again!"], [162.56, 168.81, "1882. Britain invades Egypt and takes control. Egypt strikes back!"], [168.86, 173.87, "Wait, the UK doesn't exist anymore! Egypt goes after China instead!"], [178.57, 181.79, "History repeats itself. China wins."], [181.94, 188.79, "1883. Chile marches into Lima and takes Peru's south. Peru wants it back!"], [193.49, 196.55, "History rewritten! Peru wins!"], [196.7, 206.72, "1884. Chile takes Bolivia's entire coastline. Bolivia still has a navy... On a lake. Today it wants the sea back!"], [206.77, 212.18, "But Chile is gone. Peru owns that land now, so Bolivia attacks them!"], [216.88, 219.93, "Not again! Peru takes Bolivia!"], [220.08, 227.44, "1895. Japan beats China and takes Taiwan. China has a very long memory!"], [232.14, 234.66, "China finally gets its revenge!"], [234.81, 242.9, "1896. Italy tries to conquer Ethiopia and gets humiliated at Adwa. Italy wants a second try!"], [247.6, 250.52, "Yes! Italy crushes Ethiopia!"], [250.67, 259.95, "1905. Russia sails its fleet around the whole world... And Japan sinks it in one afternoon. Revenge time!"], [260.0, 265.25, "But Japan is gone. China owns that land now, so Russia attacks them!"], [269.95, 273.63, "Some things never change. China wins!"], [273.78, 282.58, "1913. Bulgaria attacks its own allies and loses everything. Bulgaria versus Serbia, again!"], [287.28, 290.33, "What a comeback! Bulgaria wins!"], [290.48, 297.12, "1918. The Ottomans lose the Middle East to Britain. Turkey wants its empire back!"], [297.17, 301.01, "China took the UK earlier, so China pays the price!"], [305.71, 309.35, "Revenge failed! China is too strong!"], [309.5, 316.15, "1919. Romanian troops march into Budapest. Hungary wants to return the visit!"], [320.85, 323.91, "Revenge! Hungary takes Romania!"], [324.06, 331.5, "1922. Greece is pushed out of Anatolia. Greece versus Turkey. Here we go again!"], [331.55, 336.12, "Wait, Turkey doesn't exist anymore! Greece goes after China instead!"], [340.82, 344.6, "Oh no! Greece loses... Again!"], [344.75, 351.72, "1933. Peru loses the Amazon port of Leticia to Colombia. Peru attacks!"], [356.42, 359.18, "Ouch! Colombia wins again!"], [359.33, 367.57, "1940. Tiny Finland holds off the Soviet giant, but still loses Karelia. Finland strikes back!"], [367.62, 372.98, "But Russia is gone. China owns that land now, so Finland attacks them!"], [377.68, 380.9, "History repeats itself. China wins."], [381.05, 388.68, "1941. Ecuador loses a huge piece of the Amazon to Peru. Ecuador wants its jungle back!"], [388.73, 393.75, "Wait, Peru doesn't exist anymore! Ecuador goes after Colombia instead!"], [398.45, 401.75, "Not again! Colombia takes Ecuador!"], [401.9, 408.16, "1949. The Netherlands loses Indonesia. The Dutch want their islands back!"], [412.86, 416.59, "Payback time! Indonesia falls to the Netherlands!"], [416.74, 423.54, "1961. India takes Goa from Portugal in just two days. Portugal wants it back!"], [428.24, 432.29, "Some things never change. India wins!"], [432.44, 439.54, "1962. China beats India high up in the Himalayas. The two giants meet again!"], [444.24, 447.88, "Revenge failed! China is too strong!"], [448.03, 456.19, "1971. Pakistan loses its eastern half, which becomes Bangladesh. Pakistan wants revenge!"], [456.24, 460.03, "China took India earlier, so China pays the price!"], [464.73, 467.98, "History rewritten! Pakistan wins!"], [468.13, 474.31, "1975. The United States leaves Vietnam. America comes back!"], [479.01, 483.08, "Oh no! The United States loses... Again!"], [483.23, 490.1, "1978. Somalia loses the Ogaden War to Ethiopia. Somalia attacks!"], [490.15, 495.34, "Wait, Ethiopia doesn't exist anymore! Somalia goes after Italy instead!"], [500.04, 502.57, "Ouch! Italy wins again!"], [502.72, 510.08, "1979. Tanzania marches all the way into Uganda's capital. Uganda wants payback!"], [514.78, 517.49, "Uganda finally gets its revenge!"], [517.64, 526.15, "1982. Argentina loses the Falklands War to the UK. Argentina goes for the islands... And much more!"], [526.2, 532.07, "But the UK is gone. Pakistan owns that land now, so Argentina attacks them!"], [536.77, 540.25, "History repeats itself. Pakistan wins."], [540.39, 548.48, "1987. Libya loses to Chad in a war fought with... Pickup trucks. Libya wants revenge!"], [553.18, 556.13, "Yes! Libya crushes Chad!"], [556.28, 564.05, "2008. Georgia loses a five-day war to Russia. Last revenge of the night!"], [564.1, 568.71, "Pakistan took Russia earlier, so Pakistan pays the price!"], [573.41, 576.77, "Not again! Pakistan takes Georgia!"], [576.92, 581.93, "One last war for the whole world! Pakistan against Canada!"], [586.22, 588.09, "Pakistan rules the world!"], [591.92, 595.25, "Which country deserves revenge the most?"]], "labels": [], "moods": [], "duration": 594.92, "winT": 589.32, "winner": "PK", "warStart": 0.0, "titleCard": [0.1, 3.0, "EVERY COUNTRY THAT LOST A WAR", "GETS REVENGE", null], "hud": {"aliveLabel": "COUNTRIES LEFT", "status": false, "gain": true, "ruleWord": "", "noHash": true, "alive": false}, "unit": "SOLDIERS", "teamFights": false, "conqDur": 1.0, "winSub": "THE ULTIMATE REVENGE", "winWord": "WINS!", "question": ["WHICH COUNTRY DESERVES", "REVENGE THE MOST?"], "credit": "Hypothetical simulation \u00b7 Real historical wars \u00b7 Power = active troops today \u00b7 Winner absorbs half the army", "audio": {"vo": [[0.15, "/home/claude/miniguerra/x/vo_el/r4/intro_fast.wav", 1.0], [