 [], "marks": [], "rules": [[5.55, 24.94, 1588, "SPAIN WANTS REVENGE", "THE SPANISH ARMADA", "\u2694\ufe0f"], [25.04, 41.81, 1709, "SWEDEN WANTS REVENGE", "BATTLE OF POLTAVA", "\u2694\ufe0f"], [41.91, 63.58, 1842, "CHINA WANTS REVENGE", "FIRST OPIUM WAR", "\u2694\ufe0f"], [63.68, 80.72, 1848, "MEXICO WANTS REVENGE", "MEXICAN-AMERICAN WAR", "\u2694\ufe0f"], [80.82, 94.98, 1864, "DENMARK WANTS REVENGE", "SECOND SCHLESWIG WAR", "\u2694\ufe0f"], [95.08, 109.96, 1866, "AUSTRIA WANTS REVENGE", "AUSTRO-PRUSSIAN WAR", "\u2694\ufe0f"], [110.06, 126.87, 1870, "PARAGUAY WANTS REVENGE", "PARAGUAYAN WAR", "\u2694\ufe0f"], [126.97, 142.66, 1871, "FRANCE WANTS REVENGE", "FRANCO-PRUSSIAN WAR", "\u2694\ufe0f"], [142.76, 163.16, 1880, "AFGHANISTAN WANTS REVENGE", "SECOND ANGLO-AFGHAN WAR", "\u2694\ufe0f"], [163.26, 182.54, 1882, "EGYPT WANTS REVENGE", "ANGLO-EGYPTIAN WAR", "\u2694\ufe0f"], [182.64, 197.3, 1883, "PERU WANTS REVENGE", "WAR OF THE PACIFIC", "\u2694\ufe0f"], [197.4, 220.68, 1884, "BOLIVIA WANTS REVENGE", "WAR OF THE PACIFIC", "\u2694\ufe0f"], [220.78, 235.41, 1895, "CHINA WANTS REVENGE", "FIRST SINO-JAPANESE WAR", "\u2694\ufe0f"], [235.51, 251.27, 1896, "ITALY WANTS REVENGE", "BATTLE OF ADWA", "\u2694\ufe0f"], [251.37, 274.38, 1905, "RUSSIA WANTS REVENGE", "RUSSO-JAPANESE WAR", "\u2694\ufe0f"], [274.48, 291.08, 1913, "BULGARIA WANTS REVENGE", "SECOND BALKAN WAR", "\u2694\ufe0f"], [291.18, 310.1, 1918, "TURKEY WANTS REVENGE", "WORLD WAR ONE", "\u2694\ufe0f"], [310.2, 324.66, 1919, "HUNGARY WANTS REVENGE", "HUNGARIAN-ROMANIAN WAR", "\u2694\ufe0f"], [324.76, 345.35, 1922, "GREECE WANTS REVENGE", "GRECO-TURKISH WAR", "\u2694\ufe0f"], [345.45, 359.93, 1933, "PERU WANTS REVENGE", "COLOMBIA-PERU WAR", "\u2694\ufe0f"], [360.03, 381.65, 1940, "FINLAND WANTS REVENGE", "WINTER WAR", "\u2694\ufe0f"], [381.75, 402.5, 1941, "ECUADOR WANTS REVENGE", "ECUADORIAN-PERUVIAN WAR", "\u2694\ufe0f"], [402.6, 417.34, 1949, "NETHERLANDS WANTS REVENGE", "INDONESIAN INDEPENDENCE", "\u2694\ufe0f"], [417.44, 433.04, 1961, "PORTUGAL WANTS REVENGE", "ANNEXATION OF GOA", "\u2694\ufe0f"], [433.14, 448.63, 1962, "INDIA WANTS REVENGE", "SINO-INDIAN WAR", "\u2694\ufe0f"], [448.73, 468.73, 1971, "PAKISTAN WANTS REVENGE", "INDO-PAKISTANI WAR", "\u2694\ufe0f"], [468.83, 483.83, 1975, "UNITED STATES WANTS REVENGE", "VIETNAM WAR", "\u2694\ufe0f"], [483.93, 503.32, 1978, "SOMALIA WANTS REVENGE", "OGADEN WAR", "\u2694\ufe0f"], [503.42, 518.24, 1979, "UGANDA WANTS REVENGE", "UGANDA-TANZANIA WAR", "\u2694\ufe0f"], [518.34, 541.0, 1982, "ARGENTINA WANTS REVENGE", "FALKLANDS WAR", "\u2694\ufe0f"], [541.1, 556.88, 1987, "LIBYA WANTS REVENGE", "TOYOTA WAR", "\u2694\ufe0f"], [556.98, 577.52, 2008, "GEORGIA WANTS REVENGE", "RUSSO-GEORGIAN WAR", "\u2694\ufe0f"]], "chips": [], "subs": [[0.15, 5.5, "Every country that lost a war gets one shot at revenge. Let's go!"], [5.7, 16.99, "1588. Spain sends the biggest fleet in the world to invade England... And a storm wrecks it. Spain has been waiting four hundred years for this!"], [21.69, 25.04, "Revenge! Spain takes the UK!"], [25.19, 34.57, "1709. Sweden was a superpower, until Russia crushed it at Poltava. Sweden is back, and it's angry!"], [39.27, 41.91, "Ouch! Russia wins again!"], [42.06, 50.01, "1842. Britain beats China in the Opium War and takes Hong Kong. China wants it all back!"], [50.06, 55.58, "But the UK is gone. Spain owns that land now, so China attacks them!"], [60.28, 63.68, "Payback time! Spain falls to China!"], [63.83, 72.28, "1848. Mexico loses half its land, Texas, California, all of it. Mexico wants it back!"], [76.98, 80.82, "History repeats itself. The United States wins."], [80.97, 87.33, "1864. Prussia steals Schleswig from Denmark. The Danes never forgot!"], [92.03, 95.08, "Not again! Germany takes Denmark!"], [95.23, 101.96, "1866. Austria gets destroyed by Prussia in just seven weeks. Rematch!"], [106.66, 110.06, "Some things never change. Germany wins!"], [110.21, 118.68, "1870. Paraguay fights three countries at once and loses most of its men. Now Paraguay goes after Brazil!"], [123.38, 126.97, "Revenge failed! Brazil is too strong!"], [127.12, 134.45, "1871. Germany surrounds Paris and France surrenders. Round two, let's go!"], [139.15, 142.76, "Oh no! France loses... Again!"], [142.91, 150.2, "1880. Britain takes control of Afghanistan. Now the graveyard of empires wants payback!"], [150.25, 155.94, "But the UK is gone. China owns that land now, so Afghanistan attacks them!"], [160.64, 163.26, "Ouch! China wins again!"], [163.41, 169.66, "1882. Britain invades Egypt and takes control. Egypt strikes back!"], [169.71, 174.72, "Wait, the UK doesn't exist anymore! Egypt goes after China instead!"], [179.42, 182.64, "History repeats itself. China wins."], [182.79, 189.64, "1883. Chile marches into Lima and takes Peru's south. Peru wants it back!"], [194.34, 197.4, "History rewritten! Peru wins!"], [197.55, 207.57, "1884. Chile takes Bolivia's entire coastline. Bolivia still has a navy... On a lake. Today it wants the sea back!"], [207.62, 213.03, "But Chile is gone. Peru owns that land now, so Bolivia attacks them!"], [217.73, 220.78, "Not again! Peru takes Bolivia!"], [220.93, 228.29, "1895. Japan beats China and takes Taiwan. China has a very long memory!"], [232.99, 235.51, "China finally gets its revenge!"], [235.66, 243.75, "1896. Italy tries to conquer Ethiopia and gets humiliated at Adwa. Italy wants a second try!"], [248.45, 251.37, "Yes! Italy crushes Ethiopia!"], [251.52, 260.8, "1905. Russia sails its fleet around the whole world... And Japan sinks it in one afternoon. Revenge time!"], [260.85, 266.1, "But Japan is gone. China owns that land now, so Russia attacks them!"], [270.8, 274.48, "Some things never change. China wins!"], [274.63, 283.43, "1913. Bulgaria attacks its own allies and loses everything. Bulgaria versus Serbia, again!"], [288.13, 291.18, "What a comeback! Bulgaria wins!"], [291.33, 297.97, "1918. The Ottomans lose the Middle East to Britain. Turkey wants its empire back!"], [298.02, 301.86, "China took the UK earlier, so China pays the price!"], [306.56, 310.2, "Revenge failed! China is too strong!"], [310.35, 317.0, "1919. Romanian troops march into Budapest. Hungary wants to return the visit!"], [321.7, 324.76, "Revenge! Hungary takes Romania!"], [324.91, 332.35, "1922. Greece is pushed out of Anatolia. Greece versus Turkey. Here we go again!"], [332.4, 336.97, "Wait, Turkey doesn't exist anymore! Greece goes after China instead!"], [341.67, 345.45, "Oh no! Greece loses... Again!"], [345.6, 352.57, "1933. Peru loses the Amazon port of Leticia to Colombia. Peru attacks!"], [357.27, 360.03, "Ouch! Colombia wins again!"], [360.18, 368.42, "1940. Tiny Finland holds off the Soviet giant, but still loses Karelia. Finland strikes back!"], [368.47, 373.83, "But Russia is gone. China owns that land now, so Finland attacks them!"], [378.53, 381.75, "History repeats itself. China wins."], [381.9, 389.53, "1941. Ecuador loses a huge piece of the Amazon to Peru. Ecuador wants its jungle back!"], [389.58, 394.6, "Wait, Peru doesn't exist anymore! Ecuador goes after Colombia instead!"], [399.3, 402.6, "Not again! Colombia takes Ecuador!"], [402.75, 409.01, "1949. The Netherlands loses Indonesia. The Dutch want their islands back!"], [413.71, 417.44, "Payback time! Indonesia falls to the Netherlands!"], [417.59, 424.39, "1961. India takes Goa from Portugal in just two days. Portugal wants it back!"], [429.09, 433.14, "Some things never change. India wins!"], [433.29, 440.39, "1962. China beats India high up in the Himalayas. The two giants meet again!"], [445.09, 448.73, "Revenge failed! China is too strong!"], [448.88, 457.04, "1971. Pakistan loses its eastern half, which becomes Bangladesh. Pakistan wants revenge!"], [457.09, 460.88, "China took India earlier, so China pays the price!"], [465.58, 468.83, "History rewritten! Pakistan wins!"], [468.98, 475.16, "1975. The United States leaves Vietnam. America comes back!"], [479.86, 483.93, "Oh no! The United States loses... Again!"], [484.08, 490.95, "1978. Somalia loses the Ogaden War to Ethiopia. Somalia attacks!"], [491.0, 496.19, "Wait, Ethiopia doesn't exist anymore! Somalia goes after Italy instead!"], [500.89, 503.42, "Ouch! Italy wins again!"], [503.57, 510.93, "1979. Tanzania marches all the way into Uganda's capital. Uganda wants payback!"], [515.63, 518.34, "Uganda finally gets its revenge!"], [518.49, 527.0, "1982. Argentina loses the Falklands War to the UK. Argentina goes for the islands... And much more!"], [527.05, 532.92, "But the UK is gone. Pakistan owns that land now, so Argentina attacks them!"], [537.62, 541.1, "History repeats itself. Pakistan wins."], [541.25, 549.33, "1987. Libya loses to Chad in a war fought with... Pickup trucks. Libya wants revenge!"], [554.03, 556.98, "Yes! Libya crushes Chad!"], [557.12, 564.9, "2008. Georgia loses a five-day war to Russia. Last revenge of the night!"], [564.95, 569.56, "Pakistan took Russia earlier, so Pakistan pays the price!"], [574.26, 577.62, "Not again! Pakistan takes Georgia!"], [577.77, 582.78, "One last war for the whole world! Pakistan against Canada!"], [587.07, 588.94, "Pakistan rules the world!"], [592.77, 596.1, "Which country deserves revenge the most?"]], "labels": [], "moods": [], "duration": 595.77, "winT": 590.17, "winner": "PK", "warStart": 0.0, "titleCard": [0.1, 3.0, "EVERY COUNTRY THAT LOST A WAR", "GETS REVENGE", null], "hud": {"aliveLabel": "COUNTRIES LEFT", "status": false, "gain": true, "ruleWord": "", "noHash": true, "alive": false}, "unit": "SOLDIERS", "teamFights": false, "conqDur": 1.0, "winSub": "", "winWord": "WINS THE WORLD!", "question": ["WHICH COUNTRY DESERVES", "REVENGE THE MOST?"], "credit": "Hypothetical simulation \u00b7 Real historical wars \u00b7 Power = active troops today \u00b7 Winner absorbs half the army", "audio": {"vo": [[0.15, "/home/claude/miniguerra/x/vo_el/r4/c0_000.wav", 1.0], [5.7, "/home/claude/miniguerra/x