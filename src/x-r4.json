rrows": [], "booms": [], "marks": [], "rules": [[9.83, 26.71, 1588, "SPAIN WANTS REVENGE", "THE SPANISH ARMADA", "\u2694\ufe0f"], [26.81, 43.46, 1709, "SWEDEN WANTS REVENGE", "BATTLE OF POLTAVA", "\u2694\ufe0f"], [43.56, 65.29, 1880, "AFGHANISTAN WANTS REVENGE", "SECOND ANGLO-AFGHAN WAR", "\u2694\ufe0f"], [65.39, 83.46, 1848, "MEXICO WANTS REVENGE", "MEXICAN-AMERICAN WAR", "\u2694\ufe0f"], [83.56, 99.35, 1864, "DENMARK WANTS REVENGE", "SECOND SCHLESWIG WAR", "\u2694\ufe0f"], [99.45, 116.59, 1866, "AUSTRIA WANTS REVENGE", "AUSTRO-PRUSSIAN WAR", "\u2694\ufe0f"], [116.69, 135.93, 1870, "PARAGUAY WANTS REVENGE", "PARAGUAYAN WAR", "\u2694\ufe0f"], [136.03, 153.31, 1871, "FRANCE WANTS REVENGE", "FRANCO-PRUSSIAN WAR", "\u2694\ufe0f"], [153.41, 171.07, 1884, "BOLIVIA WANTS REVENGE", "WAR OF THE PACIFIC", "\u2694\ufe0f"], [171.17, 186.25, 1895, "CHINA WANTS REVENGE", "FIRST SINO-JAPANESE WAR", "\u2694\ufe0f"], [186.35, 202.78, 1896, "ITALY WANTS REVENGE", "BATTLE OF ADWA", "\u2694\ufe0f"], [202.88, 220.81, 1898, "SPAIN WANTS REVENGE", "SPANISH-AMERICAN WAR", "\u2694\ufe0f"], [220.91, 238.86, 1905, "RUSSIA WANTS REVENGE", "RUSSO-JAPANESE WAR", "\u2694\ufe0f"], [238.96, 255.05, 1913, "BULGARIA WANTS REVENGE", "SECOND BALKAN WAR", "\u2694\ufe0f"], [255.15, 271.08, 1919, "HUNGARY WANTS REVENGE", "HUNGARIAN-ROMANIAN WAR", "\u2694\ufe0f"], [271.18, 286.23, 1922, "GREECE WANTS REVENGE", "GRECO-TURKISH WAR", "\u2694\ufe0f"], [286.33, 305.04, 1940, "FINLAND WANTS REVENGE", "WINTER WAR", "\u2694\ufe0f"], [305.14, 320.77, 1941, "ECUADOR WANTS REVENGE", "ECUADORIAN-PERUVIAN WAR", "\u2694\ufe0f"], [320.87, 336.92, 1949, "NETHERLANDS WANTS REVENGE", "INDONESIAN INDEPENDENCE", "\u2694\ufe0f"], [337.02, 352.86, 1961, "PORTUGAL WANTS REVENGE", "ANNEXATION OF GOA", "\u2694\ufe0f"], [352.96, 369.7, 1962, "INDIA WANTS REVENGE", "SINO-INDIAN WAR", "\u2694\ufe0f"], [369.8, 389.75, 1971, "PAKISTAN WANTS REVENGE", "INDO-PAKISTANI WAR", "\u2694\ufe0f"], [389.85, 405.78, 1975, "UNITED STATES WANTS REVENGE", "VIETNAM WAR", "\u2694\ufe0f"], [405.88, 425.49, 1978, "SOMALIA WANTS REVENGE", "OGADEN WAR", "\u2694\ufe0f"], [425.59, 441.97, 1979, "UGANDA WANTS REVENGE", "UGANDA-TANZANIA WAR", "\u2694\ufe0f"], [442.07, 463.16, 1982, "ARGENTINA WANTS REVENGE", "FALKLANDS WAR", "\u2694\ufe0f"], [463.26, 479.61, 1987, "LIBYA WANTS REVENGE", "TOYOTA WAR", "\u2694\ufe0f"], [479.71, 498.33, 2008, "GEORGIA WANTS REVENGE", "RUSSO-GEORGIAN WAR", "\u2694\ufe0f"]], "chips": [], "subs": [[0.3, 9.63, "Every country that lost a war... gets one chance at revenge. From 1588 to today. The wheel decides who wins."], [10.03, 16.99, "In 1588, the Spanish Armada was destroyed trying to invade England."], [17.04, 19.06, "Now Spain wants revenge."], [24.21, 26.71, "Revenge! Spain takes the UK."], [27.01, 32.99, "In 1709, Sweden lost its empire to Russia at Poltava."], [33.04, 35.17, "Now Sweden wants revenge."], [40.32, 43.46, "Russia wins again. History repeats itself."], [43.76, 51.23, "In 1880, Britain won the Second Anglo-Afghan War and took control of Afghanistan."], [51.28, 57.02, "But the UK is gone. Its land now belongs to Spain. So Afghanistan attacks them."], [62.17, 65.29, "Spain wins again. History repeats itself."], [65.59, 72.01, "In 1848, Mexico lost half of its land to the United States."], [72.06, 74.48, "Now Mexico wants revenge."], [79.63, 83.46, "The United States wins again. History repeats itself."], [83.76, 88.84, "In 1864, Denmark lost Schleswig to Prussia."], [88.89, 91.04, "Now Denmark wants revenge."], [96.19, 99.35, "Germany wins again. History repeats itself."], [99.65, 105.98, "In 1866, Austria was crushed by Prussia in just seven weeks."], [106.03, 108.28, "Now Austria wants revenge."], [113.43, 116.59, "Germany wins again. History repeats itself."], [116.89, 125.31, "In 1870, Paraguay lost most of its men in a war against Brazil, Argentina and Uruguay."], [125.36, 127.61, "Now Paraguay wants revenge."], [132.76, 135.93, "Brazil wins again. History repeats itself."], [136.23, 142.83, "In 1871, France lost to Germany, and Paris was under siege."], [142.88, 145.0, "Now France wants revenge."], [150.15, 153.31, "Germany wins again. History repeats itself."], [153.61, 160.52, "In 1884, Bolivia lost its coastline to Chile. It still has a navy."], [160.57, 162.87, "Now Bolivia wants revenge."], [168.02, 171.07, "Chile wins again. History repeats itself."], [171.37, 176.5, "In 1895, China lost Taiwan to Japan."], [176.55, 178.77, "Now China wants revenge."], [183.92, 186.25, "Revenge! China takes Japan."], [186.55, 192.8, "In 1896, Italy was defeated by Ethiopia at Adwa."], [192.85, 194.97, "Now Italy wants revenge."], [200.12, 202.78, "Revenge! Italy takes Ethiopia."], [203.08, 209.76, "In 1898, Spain lost Cuba and the Philippines to the United States."], [209.81, 211.83, "Now Spain wants revenge."], [216.98, 220.81, "The United States wins again. History repeats itself."], [221.11, 225.1, "In 1905, Russia lost its fleet to Japan."], [225.15, 230.56, "But Japan is gone. Its land now belongs to China. So Russia attacks them."], [235.71, 238.86, "China wins again. History repeats itself."], [239.16, 244.91, "In 1913, Bulgaria attacked its old allies, and lost to Serbia."], [244.96, 247.4, "Now Bulgaria wants revenge."], [252.55, 255.05, "Revenge! Bulgaria takes Serbia."], [255.35, 260.21, "In 1919, Romanian troops marched into Budapest."], [260.26, 262.54, "Now Hungary wants revenge."], [267.69, 271.08, "Romania wins again. History repeats itself."], [271.38, 276.65, "In 1922, Greece was pushed out of Anatolia by Turkey."], [276.7, 278.78, "Now Greece wants revenge."], [283.93, 286.13, "Revenge! Greece takes Turkey."], [286.53, 291.33, "In 1940, Finland lost Karelia to the Soviet Union."], [291.38, 296.74, "But Russia is gone. Its land now belongs to China. So Finland attacks them."], [301.89, 305.04, "China wins again. History repeats itself."], [305.34, 310.87, "In 1941, Ecuador lost a huge part of the Amazon to Peru."], [310.92, 313.27, "Now Ecuador wants revenge."], [318.42, 320.77, "Revenge! Ecuador takes Peru."], [321.07, 325.59, "In 1949, the Netherlands lost Indonesia."], [325.64, 328.2, "Now the Netherlands wants revenge."], [333.35, 336.92, "Indonesia wins again. History repeats itself."], [337.22, 342.43, "In 1961, India took Goa from Portugal in two days."], [342.48, 344.57, "Now Portugal wants revenge."], [349.72, 352.86, "India wins again. History repeats itself."], [353.16, 359.09, "In 1962, India lost a short war against China in the Himalayas."], [359.14, 361.4, "Now India wants revenge."], [366.55, 369.7, "China wins again. History repeats itself."], [370.0, 375.71, "In 1971, Pakistan lost the east, which became Bangladesh."], [375.76, 381.45, "But India is gone. Its land now belongs to China. So Pakistan attacks them."], [386.6, 389.75, "China wins again. History repeats itself."], [390.05, 394.8, "In 1975, the United States left Vietnam."], [394.85, 397.51, "Now the United States wants revenge."], [402.66, 405.78, "Revenge! The United States takes Vietnam."], [406.08, 411.41, "In 1978, Somalia lost the Ogaden War to Ethiopia."], [411.46, 417.29, "But Ethiopia is gone. Its land now belongs to Italy. So Somalia attacks them."], [422.44, 425.49, "Italy wins again. History repeats itself."], [425.79, 431.56, "In 1979, Tanzania marched into Uganda and took Kampala."], [431.61, 434.16, "Now Uganda wants revenge."], [439.31, 441.98, "Revenge! Uganda takes Tanzania."], [442.27, 447.72, "In 1982, Argentina lost the Falklands War to the UK."], [447.77, 454.18, "But the UK is gone. Its land now belongs to the United States. So Argentina attacks them."], [459.33, 463.16, "The United States wins again. History repeats itself."], [463.46, 469.18, "In 1987, Libya lost to Chad... in a war fought with pickup trucks."], [469.23, 471.41, "Now Libya wants revenge."], [476.56, 479.61, "Chad wins again. History repeats itself."], [479.91, 484.57, "In 2008, Georgia lost a five-day war against Russia."], [484.62, 490.03, "But Russia is gone. Its land now belongs to China. So Georgia attacks them."], [495.18, 498.33, "China wins again. History repeats itself."], [498.73, 505.46, "After every revenge, this is the new world. The biggest winners: China, the United States, Brazil...."], [506.36, 510.44, "One last war for the world. China against the United States."], [519.64, 522.47, "China wins the biggest revenge of all."], [526.69, 529.48, "Which country deserves revenge the most?"]], "labels": [], "moods": [], "duration": 529.69, "winT": 523.29, "winner": "CN", "warStart": 0.0, "titleCard": [0.15, 3.0, "EVERY COUNTRY THAT LOST A WAR", "GETS REVENGE", null], "hud": {"aliveLabel": "COUNTRIES LEFT", "status": false, "gain": true, "ruleWord": "", "noHash": true, "alive": false}, "unit": "SOLDIERS", "teamFights": false, "conqDur": 1.0, "winSub": "", "winWord": "WINS THE WORLD!", "question": ["WHICH COUNTRY DESERVES", "REVENGE THE MOST?"], "credit": "Hypothetical simulation \u00b7 Real historical wars \u00b7 Power = active troops today \u00b7 Winner absorbs half the army", "audio": {"vo": [[0.3, "/home/claude/miniguerra/x/vo/98c8927c662daaac.wav", 1.0], [10.03, "/home/claude/miniguerra/x/vo/ae53f1e9e6cab244.wav", 1.0], [17.04, "/home/claude/miniguerra/x/vo/2a7b7562a309aa69.wav", 1.0], [24.21, "/home/claude/miniguerra/x/vo/6b4a5633424405eb.wav", 1.0], [27.01, "/home/claude/miniguerra/x/vo/a2066f1fb60790fc.wav", 1.0], [33.04, "/home/claude/miniguerra/x/vo/204bdd35b4d6423f.wav", 1.0], [40.32, "/home/claude/miniguerra/x/vo/56697f8a4cf5f3fe.wav", 1.0], [43.76, "/home/claude/miniguerra/x/vo/5d1850cadda68d3b.wav", 1.0], [51.28, "/home/claude/miniguerra/x/vo/3e48c72c78b57d7c.wav", 1.0], [62.17, "/home/claude/miniguerra/x/vo/86d7b41965bf981d.wav", 1.0], [65.59, "/home/claude/miniguerra/x/vo/54490a9b81e56022.wav", 1.0], [72.06, "/home/claude/miniguerra/x/vo/4fa090f01fe9149e.wav", 1.0], [79.63, "/home/claude/miniguerra/x/vo/286a13e1532b3ded.wav", 1.0], [83.76, "/home/claude